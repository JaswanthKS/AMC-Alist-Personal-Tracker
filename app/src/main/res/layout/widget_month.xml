<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="A-LIST · THIS MONTH"
        android:textColor="#FFFFC857"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/w_visits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 visits"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00 in free tickets"
        android:textColor="#FFD7D8E6"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="#FF3DDC84"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#FF9A9CB0"
        android:textSize="12sp" />
</LinearLayout>
